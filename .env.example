# Copy to .env and fill in the keys. Never commit .env.

# Which OpenAI-compatible API llm.py calls:
#   deepseek   = DeepSeek's own API, for local development
#   openrouter = the organisers' key, for the submitted runs
LLM_PROVIDER=deepseek

# DeepSeek's own API (development only)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash serves DeepSeek-V4.1-Flash-1017, the same model as OpenRouter's deepseek/deepseek-v4.1-flash
DEEPSEEK_MODEL=deepseek-flash

# OpenRouter (the brief's $5 budget and spend dashboard are tied to this key)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Upstream host to pin via provider.order; confirm the exact slug in M7
OPENROUTER_PROVIDER=
