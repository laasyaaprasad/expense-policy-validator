# Copy to .env and fill in the key. Never commit .env.

# Which OpenAI-compatible API llm.py calls:
#   openrouter = OpenRouter (the default); the submitted run used it
#   deepseek   = DeepSeek's own API; the first scored run used it
LLM_PROVIDER=openrouter

# OpenRouter (the brief's $5 budget and spend dashboard are tied to this key)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Upstream hosts to pin via provider.order, comma-separated. Empty means Fireworks,Together, the two
# that returned logprobs in the smoke test; an unpinned call can land on a host that drops them.
OPENROUTER_PROVIDER=

# DeepSeek's own API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash serves DeepSeek-V4.1-Flash-1017, the same model as OpenRouter's deepseek/deepseek-v4.1-flash
DEEPSEEK_MODEL=deepseek-flash
