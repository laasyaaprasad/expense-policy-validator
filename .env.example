# Copy to .env and fill in the keys. Never commit .env.

# Which OpenAI-compatible API llm.py calls:
#   deepseek   = DeepSeek's own API; the submitted run used it
#   openrouter = OpenRouter; implemented and tested offline, not yet run against the live API
LLM_PROVIDER=deepseek

# DeepSeek's own API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash serves DeepSeek-V4.1-Flash-1017, the same model as OpenRouter's deepseek/deepseek-v4.1-flash
DEEPSEEK_MODEL=deepseek-flash

# OpenRouter (the brief's $5 budget and spend dashboard are tied to this key)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Optional upstream hosts to pin via provider.order, comma-separated; empty lets OpenRouter choose
OPENROUTER_PROVIDER=
