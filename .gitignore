.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# The organisers' brief and data (including the answer key) are not redistributed.
# Reviewers copy their own data/ folder to the repo root (README, Setup).
validator-brief-junior-mid.html
data/

# Local editor and assistant tooling.
.claude/

# Run log: when each run happened, on which commit, and how long it took (validator/trace.py).
logs/

# Experiment 3 cache: every prompt holds the full text of a policy rule, which is the organisers' data.
experiments/policy_config/cache/
# Experiment 4 LLM cache: every prompt holds the full text of a policy rule.
experiments/graph_retrieval/cache/policy_graph/
# Experiment 6 cache: 24 MB, mostly classification responses with five alternatives per token; not committed (its README).
experiments/semantic_first/cache/
experiments/semantic_first/run.log
experiments/semantic_v2/run.log
experiments/semantic_v3/run.log
experiments/semantic_v31/run.log
experiments/semantic_v32/run.log

# The lookup recalibration cache (validator/calibrate.py): vectors of a client's reviewed lines.
rules/lookup/calibration-cache.npz

# People's reviews and what the lookup learned from them (validator/reviews.py, validator/learn.py): demo data, kept out
# of git so a review can't change the committed results. A real deployment stores them per client (docs/aws-design.md).
rules/lookup/reviews.jsonl
rules/lookup/learn_log.jsonl
rules/lookup/clients/
